rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sports_shops/{shopId} {
      allow read, write: if request.auth != null; // Allow access only to authenticated users
    }
    
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId; // Allow users to read/write their own data
    }
    
    // Additional rules can be added here for other collections
  }
}